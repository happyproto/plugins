{
  "extends": "../../../release/package-paths.mjs",
  "packagePaths": ["plugins/happyview/backlinks", "Cargo.lock"],
  "branches": [
    "main",
    { "name": "beta", "prerelease": true },
    { "name": "alpha", "prerelease": true }
  ],
  "tagFormat": "happyview-backlinks-v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "semantic-release-export-data",
    ["@semantic-release/exec", {
      "prepareCmd": "cargo build --release --target wasm32-unknown-unknown -p happyview-backlinks && jq '.version = \"${nextRelease.version}\"' manifest.json > manifest.tmp && mv manifest.tmp manifest.json"
    }],
    ["@semantic-release/github", {
      "assets": [
        {"path": "../../../target/wasm32-unknown-unknown/release/happyview_backlinks.wasm", "name": "happyview-backlinks.wasm", "label": "Backlinks Library Plugin WASM"},
        {"path": "manifest.json", "name": "manifest.json", "label": "Plugin Manifest"}
      ]
    }]
  ]
}
