{
  "extends": "../../../release/package-paths.mjs",
  "packagePaths": ["plugins/happyview/javascript", "plugins/happyview/quickjs"],
  "branches": ["main"],
  "tagFormat": "happyview-javascript-v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", {
      "prepareCmd": "cargo build --release --target wasm32-wasip1 -p happyview-javascript && jq '.version = \"${nextRelease.version}\"' manifest.json > manifest.tmp && mv manifest.tmp manifest.json"
    }],
    ["@semantic-release/github", {
      "assets": [
        {"path": "../../../target/wasm32-wasip1/release/happyview_javascript.wasm", "name": "happyview-javascript.wasm", "label": "JavaScript Interpreter Plugin WASM"},
        {"path": "manifest.json", "name": "manifest.json", "label": "Plugin Manifest"}
      ]
    }]
  ]
}
