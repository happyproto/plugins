{
  "extends": "semantic-release-monorepo",
  "branches": ["main"],
  "tagFormat": "happyview-lua-v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", {
      "prepareCmd": "cargo build --release --target wasm32-wasip1 -p happyview-lua && jq '.version = \"${nextRelease.version}\"' manifest.json > manifest.tmp && mv manifest.tmp manifest.json"
    }],
    ["@semantic-release/github", {
      "assets": [
        {"path": "../../../target/wasm32-wasip1/release/happyview_lua.wasm", "name": "happyview-lua.wasm", "label": "Lua Interpreter Plugin WASM"},
        {"path": "manifest.json", "name": "manifest.json", "label": "Plugin Manifest"}
      ]
    }]
  ]
}
